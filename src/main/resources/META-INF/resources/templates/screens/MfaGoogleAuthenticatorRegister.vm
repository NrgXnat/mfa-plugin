#set($disabled=true)
$!data.getTemplateInfo().setLayoutTemplate("Noninteractive.vm")
<script type="text/javascript" src="$content.getURI("/scripts/mfa/multifactorAuth.js")"></script>
<div id="mfa-login-container">
<h2>MFA using Google Authenticator</h2>
</div>

<script type="text/javascript">
$(document).ready(function() {
    $("#xnat_power").hide();
	var multifactorAuthPanel = {
		tag: 'div',
		contents:{
			mfaStyleSheet: {
				tag: 'link|rel=stylesheet|type=text/css|href="~/style/mfa/multifactorAuth.css"'
			},
			authenticatorSetupHeader: {
				tag: 'div#authenticator-setup',
				contents: {
				    authenticatorSetupMessage: {
				        tag: 'p',
                        contents:
                            'This XNAT instance requires Multifactor Authentication to be enabled. ' +
                            'Using the Google Authenticator App, either scan the QR code below or manually enter the 16 digit secret key. ' +
                            'Then enter your 6 digit verification code in the text box below. '
				    }
				}
			},
			authenticatorQR: {
				tag:'div#authenticator-qr',
				contents: {
				    authenticatorQRCode: {
				        tag: 'div#authenticator-qr-code'
				    },
				    authenticatorSecret: {
                        tag:'div#authenticator-secret',
                        contents:
                            '<p><strong>Secret:</strong>&nbsp;<code></code></p>'
                    }
				}
			},
			authenticatorVerify: {
				tag: 'div#authenticator-verify',
				contents:
				    '<p><strong>Enter code from Authenticator:</strong></p>' +
					'<p><input type="text" id="authenticator-code" size="6" maxlength="6" placeholder="888888" />' +
					'<span id="mfa-error"><i class="fa fa-exclamation-circle"></i>&nbsp;<span id="error-msg"></span></span></p>' +
					'<a class="btn1 mfa-verify-btn"" id="mfa-login-btn" onclick="XNAT.app.MultifactorAuth.mfaLogin()" href="#!">Verify Code</a>'
			},
			authHelpMessage: {
			    tag: 'div#mfa-email-btn.auth-help.message',
			    contents:
			        'Problems authenticating? As a fallback, you can ' +
			        '<a href="#!" class="switch-to-email">receive an authentication code via email</a>'
			}
		}
	}
	XNAT.spawner.spawn({multifactorAuthPanel}).render($("div#mfa-login-container"));
	XNAT.app.MultifactorAuth.renderGoogleAuthSetup();
	XNAT.app.MultifactorAuth.renderSwitchEmailButton();
	$(".switch-to-email").click(function(event) {
		event.preventDefault();
		XNAT.app.MultifactorAuth.switchToEmail();
	});
});
</script>