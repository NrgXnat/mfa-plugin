#set($disabled=true)
$!data.getTemplateInfo().setLayoutTemplate("Noninteractive.vm")
<script type="text/javascript" src="$content.getURI("/scripts/mfa/multifactorAuth.js")"></script>
<link ref="stylesheet" type="text/css" href="$content.getURI("/style/mfa/multifactorAuthUserProfile.css")" />

<div id="mfa-login-container">
<h2>MFA using Google Authenticator</h2>
</div>

<script type="text/javascript">
$(document).ready(function() {
    $("#xnat_power").hide();
	var multifactorAuthPanel = {
		tag: 'div',
		contents:{
			authenticatorSetupHeader: {
				tag: 'div#authenticator-setup',
				element: {
					style: { margin: '0 0 2em' }
				},
				contents:
					'<div class="message">' +
					'This XNAT instance requires Multifactor Authentication to be enabled. Using the Google Authenticator App, either scan the QR code below or manually enter the 16 digit secret key. ' + 
					'Then enter your 6 digit verification code in the text box below. ' +
					'</div>'
			},
			authenticatorSecret: {
				tag:'div#authenticator-secret'
			},
			authenticatorQR: {
				tag:'div#authenticator-qr'
			},
			authenticatorVerify: {
				tag: 'div#authenticator-verify',
				contents:
					'<input type="text" id="authenticator-code" size="11" maxlength="6"></input>' + 
					'<a class="btn1 mfa-verify-btn"" id="mfa-login-btn" onclick="XNAT.app.MultifactorAuth.mfaLogin()" href="#!">Verify Code</a>' + 
					'<span id="mfa-error"><i class="fa fa-asterisk"></i><span id="error-msg"></span></span>' 
			},
			switchToEmail: {
				tag: 'button#mfa-email-btn.btn.btn1|type="button"',
				element: {
					style: { margin: '0 0 2em' }
				},
				contents: 'Switch To Email'
			}
		}
	}
	XNAT.spawner.spawn({multifactorAuthPanel}).render($("div#mfa-login-container"));
	XNAT.app.MultifactorAuth.renderGoogleAuthSetup();
	XNAT.app.MultifactorAuth.renderSwitchEmailButton();
	$("#mfa-email-btn").click(function(event) {
		event.preventDefault();
		XNAT.app.MultifactorAuth.switchToEmail();
	});
});
</script>